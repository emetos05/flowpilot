# Copy to apps/api/.env. Never commit real credentials.
DATABASE_URL=postgresql://flowpilot:flowpilot-local@127.0.0.1:5432/flowpilot
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=1000
AGENT_MAX_STEPS=6
AGENT_TIMEOUT_SECONDS=90

# Optional shell settings, not loaded by Uvicorn from this file.
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000
